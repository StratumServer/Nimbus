<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A plugin that loads cleanly and then throws on the way out. Its own assembly rather than a
    second type in Nimbus.BrokenPlugin, because the manifest id is per file: two concrete plugin
    types in one dll make the second a duplicate of the first.

    Not referenced by the test assembly: it is an input file, not a dependency.
  -->
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Test input, not product code: keeps it out of Sonar's coverage denominator. -->
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <!--
      One output path whatever the configuration. This project is not in Nimbus.slnx, so a
      solution build has no configuration mapping for it and it falls back to Debug while the
      test project that stages its dll is building Release. Pinning the path is what keeps the
      two agreeing on where the file is.
    -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\fixture\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Nimbus.Api\Nimbus.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
